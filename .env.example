# ==============================================================================
# BUSINESS ANALYTICS OPERATING SYSTEM - CONFIGURATION
# ==============================================================================

# --- Telegram Bot Configuration ---
# Obtain from @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- LLM API Keys ---
# OpenAI API Key (used for GPT models & embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (used for Claude 3.5 Sonnet / Claude 3.7 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection (e.g. gpt-4o, claude-3-7-sonnet-20250219, gpt-4o-mini)
SUPERVISOR_MODEL=gpt-4o
DATA_SCIENTIST_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Database Configuration ---
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/analytics_os
# SQLite fallback (Default for local testing without PostgreSQL server running):
DATABASE_URL=sqlite+aiosqlite:///./analytics_os.db

# --- API & Server Settings ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=true

# --- Project Storage Settings ---
# Directory where all isolated project files, raw inputs, and outputs will be stored
PROJECTS_STORAGE_DIR=./projects

# Maximum upload file size in bytes (e.g., 50MB = 52428800)
MAX_FILE_SIZE_BYTES=52428800
